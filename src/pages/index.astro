---
/**
 * Portada — dirección `institucional con evidencia` (DESIGN.md §14).
 *
 * El recorrido, y la razón de este orden: qué es la red (hero + cifras) → qué
 * dice de sí misma (Quiénes somos) → qué ha hecho (Historia) → en qué trabaja
 * (Líneas) → qué viene ahora (XV Foro) → prueba documental (Memoria) → dónde
 * está (Nodos) → cómo se le escribe (Contacto).
 *
 * ⚠️ Actualidad y Proyectos NO están, y no es un olvido (D52): ocupaban casi un
 * tercio del recorrido como huecos declarados desde el 29 de julio y el contenido
 * no llegó. La regla §8.5 —si no hay contenido real, la sección no existe—
 * también las alcanza. Vuelven solas el día que el grupo cargue una fila.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import QuienesSomos from '../components/QuienesSomos.astro';
import LineaTiempo from '../components/LineaTiempo.astro';
import LineasTrabajo from '../components/LineasTrabajo.astro';
import Foro from '../components/Foro.astro';
import ArchivoMemoria from '../components/ArchivoMemoria.astro';
import MapaNodos from '../components/MapaNodos.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Header />

  <main id="contenido">
    <Hero />
    <QuienesSomos />
    <LineaTiempo />
    <LineasTrabajo />
    <Foro />
    <ArchivoMemoria />
    <MapaNodos />
    <Contacto />
  </main>

  <Footer />
</Base>
