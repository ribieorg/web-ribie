---
/**
 * Cifras de la red — sobre banda negra.
 *
 * Tipografía enorme y un color vivo por cifra, escalonadas en vertical para que
 * la fila no se lea como una tabla. Es la corrección del "bloque de métricas" del
 * mockup y, sobre todo, de la versión anterior de este componente: era demasiado
 * tímida para sostener una sección entera.
 *
 * Las cifras sin verificar se apagan y llevan su nota. Nunca se inventa un número,
 * ni siquiera cuando el diseño pide que grite.
 */
import { cifras } from '../data/contenido';

const TONOS = ['var(--surface)', 'var(--viv-cian)', 'var(--viv-verde)', 'var(--viv-amarillo)'];
---

<ul class="cifras reveal">
  {cifras.items.map((item, i) => (
    <li
      class:list={['cifra', !item.hayDato && 'cifra--pendiente']}
      style={`--tono:${TONOS[i % TONOS.length]}`}
    >
      <span class="valor">{item.valor}</span>
      <span class="etiqueta">{item.etiqueta}</span>
      {!item.verificado && <span class="nota">por confirmar</span>}
    </li>
  ))}
</ul>

<style>
  .cifras {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-12) 5vw;
    border-top: 1px solid var(--void-line);
    padding-top: var(--space-12);
  }
  /* Escalonado: la segunda y la cuarta bajan. Una fila perfectamente alineada
     vuelve a leerse como la tabla de métricas de plantilla. */
  .cifra:nth-child(even) { margin-top: var(--space-8); }

  .cifra { display: flex; flex-direction: column; }

  .valor {
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 2rem + 4.2vw, 6.5rem);
    font-weight: 600;
    line-height: 0.88;
    letter-spacing: -0.03em;
    color: var(--tono);
    font-variant-numeric: tabular-nums;
  }
  .etiqueta {
    margin-top: var(--space-4);
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--void-mute);
    max-width: 26ch;
  }

  /* Sin verificar: el número se apaga, pero NO hasta desaparecer. A #3A3A38 el
     guión se perdía sobre el negro y la etiqueta quedaba flotando sin ancla — con
     tres de las cuatro cifras por confirmar, la fila entera parecía rota. Este
     gris da 3,03:1, el mínimo para una pieza de 104px, y deja ver que hay un
     hueco esperando un dato en vez de disimularlo. */
  .cifra--pendiente .valor { color: #5A5A55; }

  .nota {
    margin-top: var(--space-2);
    align-self: flex-start;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  @media (max-width: 60rem) {
    .cifras { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 34rem) {
    .cifras { grid-template-columns: 1fr; }
    .cifra:nth-child(even) { margin-top: 0; }
  }
</style>
