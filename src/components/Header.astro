---
/**
 * Cabecera — franja de preparación, barra institucional, logotipo y navegación.
 *
 * La barra de turquesa profundo dice qué es RIBIE antes de que el visitante tenga
 * que deducirlo del logotipo. Es convención de sitio institucional, y aquí además
 * carga el argumento de la dirección: la primera línea del sitio ya es evidencia
 * —«Programa CYTED», «21 países · desde 1990»—.
 *
 * En móvil la navegación se sustituye por un enlace al índice del pie, no por un
 * panel desplegable: seis anclas no justifican un componente con estado, y ese
 * panel costaba el único JavaScript propio que quedaba en la cabecera.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo-ribie.png';
import { navegacion, barra, sitio, franja, MOSTRAR_FRANJA } from '../data/contenido';
---

{MOSTRAR_FRANJA && <p class="preparacion">{franja}</p>}

<div class="barra">
  <div>
    <span>{barra.izquierda}</span>
    <span>{barra.derecha}</span>
  </div>
</div>

<header class="cabecera">
  <div>
    <a class="marca" href="/" aria-label={`${sitio.nombre} — inicio`}>
      <Image src={logo} alt={sitio.nombre} height={44} densities={[1, 2]} loading="eager" />
    </a>
    <nav aria-label="Principal">
      {navegacion.map((n) => <a href={n.ancla}>{n.texto}</a>)}
    </nav>
    <a class="indice" href="#pie">Índice</a>
  </div>
</header>

<style>
  .preparacion {
    background: var(--accent-tint);
    border-bottom: 1px solid var(--border-hairline);
    font-size: .78125rem;
    color: var(--ink-700);
    text-align: center;
    padding: var(--space-2) var(--margen);
    margin: 0;
  }

  .barra { background: var(--brand-deep); color: #fff; font-size: .8125rem; }
  .barra > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--margen);
  }

  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / .97);
    border-bottom: 1px solid var(--border-hairline);
  }
  .cabecera > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    padding: var(--space-3) var(--margen);
  }
  .marca { display: flex; line-height: 0; }
  .marca :global(img) { height: 44px; width: auto; }

  nav { display: flex; gap: clamp(.875rem, 2.2vw, 2rem); }
  nav a {
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--ink-700);
    text-decoration: none;
    padding-bottom: 3px;
    border-bottom: 3px solid transparent;
    white-space: nowrap;
    transition: border-color var(--dur-standard) var(--ease-out),
                color var(--dur-standard) var(--ease-out);
  }
  nav a:hover { color: var(--brand-deep); border-bottom-color: var(--brand); }

  .indice {
    display: none;
    font-family: var(--font-display);
    font-size: .875rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--brand-deep);
    border: 1px solid var(--border-strong);
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
  }

  @media (max-width: 47.5rem) {
    .barra > div { flex-direction: column; gap: 2px; }
    nav { display: none; }
    .indice { display: inline-block; }
  }
</style>
