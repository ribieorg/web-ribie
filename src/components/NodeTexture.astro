---
/**
 * Textura de red de nodos — decorativa.
 * Rima con el isotipo de RIBIE (constelación de nodos conectados).
 * Es `aria-hidden`: no aporta información, solo atmósfera.
 */
interface Props {
  variante?: 'clara' | 'oscura';
  opacidad?: number;
  /**
   * Red viva: los enlaces se trazan y los nodos laten (DESIGN.md §11).
   * Solo en el hero — animar la textura en cada banda sería ruido, no atmósfera.
   * Todo el movimiento es CSS puro sobre `opacity` y `stroke-dashoffset`: ni un
   * byte de JavaScript, y `prefers-reduced-motion` lo apaga desde tokens.css.
   */
  animada?: boolean;
}
const { variante = 'clara', opacidad = 1, animada = false } = Astro.props;

const trazo = variante === 'oscura' ? 'rgba(255,255,255,.28)' : 'var(--node-1)';
const nodo  = variante === 'oscura' ? 'rgba(255,255,255,.45)' : 'var(--brand)';

// Posiciones fijas: la textura debe ser idéntica en cada build (nada aleatorio)
const puntos = [
  [6, 18], [17, 9], [14, 34], [27, 24], [23, 48], [36, 13], [38, 39],
  [48, 28], [46, 55], [59, 18], [62, 43], [72, 31], [70, 60], [83, 22],
  [86, 47], [93, 35], [31, 68], [55, 76], [77, 80], [12, 60],
];
const enlaces = [
  [0, 1], [0, 2], [1, 5], [2, 3], [3, 4], [3, 6], [5, 6], [6, 7], [7, 8],
  [7, 9], [9, 11], [10, 11], [11, 12], [11, 13], [13, 15], [14, 15], [12, 14],
  [4, 16], [16, 17], [17, 18], [18, 12], [19, 2], [19, 16], [8, 17], [10, 8],
];
---

<svg
  class:list={['textura', animada && 'textura--viva']}
  viewBox="0 0 100 90"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
  style={`--o:${opacidad}`}
>
  {enlaces.map(([a, b], i) => (
    <line
      x1={puntos[a][0]} y1={puntos[a][1]}
      x2={puntos[b][0]} y2={puntos[b][1]}
      stroke={trazo}
      stroke-width="0.18"
      style={`--i:${i}`}
    />
  ))}
  {puntos.map(([x, y], i) => (
    <circle cx={x} cy={y} r={i % 4 === 0 ? 0.85 : 0.5} fill={nodo} style={`--i:${i}`} />
  ))}
</svg>

<style>
  .textura {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: var(--o);
    pointer-events: none;
  }

  /* --- Red viva -----------------------------------------------------------
     Dos gestos y ninguno más: el enlace se traza una vez al cargar, y el nodo
     late en bucle largo. Es una constelación, no un salvapantallas. */
  .textura--viva line {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: trazar 1.4s var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 45ms);
  }
  .textura--viva circle {
    opacity: 0;
    animation:
      surgir .5s var(--ease-out) forwards,
      latir 6s ease-in-out infinite;
    /* El nodo aparece cuando su enlace ya llegó, no antes */
    animation-delay: calc(600ms + var(--i) * 55ms), calc(2s + var(--i) * 180ms);
  }

  @keyframes trazar { to { stroke-dashoffset: 0; } }
  @keyframes surgir { to { opacity: 1; } }
  @keyframes latir {
    0%, 100% { opacity: 1; }
    50%      { opacity: .35; }
  }

  /* Sin movimiento: la red se ve completa desde el primer fotograma.
     El @media global de tokens.css lleva las duraciones a .01ms, pero eso
     sin este bloque dejaría los nodos en su estado inicial (invisibles). */
  @media (prefers-reduced-motion: reduce) {
    .textura--viva line   { stroke-dashoffset: 0; animation: none; }
    .textura--viva circle { opacity: 1; animation: none; }
  }
</style>
