---
/**
 * Banda del XV Foro — bloque negro con la diagonal del sitio en el borde superior.
 *
 * Dos columnas desiguales apoyadas en su base: a la izquierda el titular y el
 * texto, a la derecha la ficha de datos y la única llamada a la acción del sitio.
 * Alinearlas por abajo (`align-items: end`) es lo que hace que el bloque se
 * apoye en su borde inferior en vez de flotar centrado.
 *
 * Los datos de fecha, sede y modalidad están VERIFICADOS en los requerimientos
 * oficiales del 13 jul 2026; falta el día exacto y el enlace de inscripción.
 */
import NodeTexture from './NodeTexture.astro';
import Rayado from './Rayado.astro';
import Marca from './Marca.astro';
import { foro } from '../data/contenido';
---

<section id="foro" class="banda">
  <div class="fondo">
    <Rayado
      id="ribieForoRayas"
      ancho={1440}
      alto={660}
      paso={14}
      anchoRaya={6}
      fondo="#0B0B0B"
      raya="#1A1A1A"
      opacidad={0.45}
      pie="[ foto de fondo: sesión plenaria del foro / campus U. de Nariño — 2400 × 1200 ]"
      pieAlMargen
    />
    <NodeTexture variante="oscura" opacidad={0.4} />
  </div>

  <div class="contenedor cuerpo">
    <div class="principal reveal">
      <p class="eyebrow eyebrow--claro">{foro.eyebrow}</p>
      <h2>{foro.nombre}</h2>
      <p class="descripcion">{foro.descripcion}</p>
    </div>

    <div class="ficha reveal">
      <dl>
        <div class="dato">
          <dt>Fecha</dt>
          <dd>
            {foro.fecha}
            {foro.fechaProvisional && <Marca texto="Días por confirmar" />}
          </dd>
        </div>
        <div class="dato">
          <dt>Sede</dt>
          <dd>{foro.lugar}</dd>
        </div>
        <div class="dato">
          <dt>Modalidad</dt>
          <dd>{foro.modalidad}</dd>
        </div>
      </dl>

      <div class="acciones">
        {foro.cta.url ? (
          <a href={foro.cta.url} class="boton boton--accion" rel="noopener">{foro.cta.texto}</a>
        ) : (
          <>
            {/* Un botón sin destino no se disfraza de botón activo */}
            <span class="boton boton--accion boton--inactivo" aria-disabled="true">{foro.cta.texto}</span>
            <Marca texto="Enlace pendiente de RIBIE" />
          </>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .banda {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--void);
    color: #fff;
    padding-block: calc(var(--section-gap) + 5vw) var(--section-gap);
    /* La misma diagonal del hero, en el borde superior: un solo ángulo (§11).
       En `vw` y no en `%` del alto: con porcentaje el ángulo cambiaría según lo
       alta que sea cada sección, y dejarían de ser la misma diagonal. */
    clip-path: polygon(0 6.5vw, 100% 0, 100% 100%, 0 100%);
    margin-top: -1px;
  }
  .fondo { position: absolute; inset: 0; z-index: -1; }
  /* Bajo la punta de la diagonal, un pie anclado abajo quedaría a media altura
     de la sección; se sube a justo debajo del corte. */
  .fondo :global(.pie-hueco) { bottom: auto; top: calc(6.5vw + var(--space-8)); }

  .cuerpo {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(var(--space-8), 6vw, var(--space-24));
    align-items: end;
  }

  .eyebrow--claro { color: var(--viv-verde); font-weight: 700; }
  h2 { color: #fff; max-width: 22ch; }
  .descripcion {
    margin-top: var(--space-6);
    font-size: var(--text-lead);
    color: var(--void-text);
    max-width: 62ch;
  }

  /* Ficha de datos: líneas horizontales y nada más. Ni caja, ni fondo, ni anillo
     — sobre negro, una línea de 1px basta para separar. */
  .ficha dl { display: flex; flex-direction: column; }
  .dato {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid #333;
  }
  .dato:last-of-type { padding-bottom: var(--space-6); }
  .dato dt {
    font-size: var(--text-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    font-weight: 600;
    color: var(--void-mute);
  }
  .dato dd {
    font-size: var(--text-small);
    font-weight: 500;
    color: #fff;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .acciones {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .boton--inactivo { opacity: 0.55; cursor: not-allowed; }

  @media (max-width: 60rem) {
    .cuerpo { grid-template-columns: 1fr; gap: var(--space-12); align-items: start; }
  }
  /* Móvil: la diagonal se aplana — en pantalla estrecha se come el alto útil */
  @media (max-width: 47.5rem) {
    .banda { clip-path: none; margin-top: 0; padding-top: var(--section-gap); }
    .fondo :global(.pie-hueco) { display: none; }
  }
</style>
