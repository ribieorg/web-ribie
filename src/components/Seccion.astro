---
/**
 * Envoltura de sección: encabezado (eyebrow + título) y contenido.
 * Centraliza el ritmo vertical para que ninguna sección invente su propio espaciado.
 *
 * El `tono` NO es decorativo: la alternancia negro ↔ hueso es lo que impide que
 * todas las bandas se lean iguales, que era el problema de fondo del rediseño (§11).
 */
import Marca from './Marca.astro';

interface Props {
  id: string;
  eyebrow?: string;
  titulo?: string;
  destacado?: string;
  alterna?: boolean;
  provisional?: boolean;
  ancho?: 'normal' | 'estrecho';
  tono?: 'claro' | 'oscuro' | 'carbon' | 'turquesa' | 'purpura';
  /** Encabezado partido: eyebrow y título a la izquierda, entradilla a la derecha. */
  entradilla?: string;
}
const {
  id, eyebrow, titulo, destacado,
  alterna = false, provisional = false, ancho = 'normal',
  tono = 'claro', entradilla,
} = Astro.props;
---

<section
  id={id}
  class:list={[
    'seccion',
    alterna && tono === 'claro' && 'seccion--alt',
    tono === 'oscuro' && 'seccion--oscura',
    tono === 'carbon' && 'seccion--carbon',
    tono === 'turquesa' && 'seccion--turquesa',
    tono === 'purpura' && 'seccion--purpura',
  ]}
>
  <div class="contenedor">
    {(eyebrow || titulo) && (
      <header
        class:list={[
          'encabezado',
          ancho === 'estrecho' && !entradilla && 'medida',
          entradilla && 'encabezado--partido',
          'reveal',
        ]}
      >
        <div>
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {titulo && (
            <h2>
              {titulo}{' '}
              {destacado && <span class="destacado">{destacado}</span>}
            </h2>
          )}
          {provisional && (
            <p class="marca-linea"><Marca /></p>
          )}
        </div>
        {entradilla && <p class="entradilla">{entradilla}</p>}
      </header>
    )}
    <slot />
  </div>
</section>

<style>
  .encabezado { margin-bottom: var(--space-12); }
  .marca-linea { margin-top: var(--space-4); }

  /* Anchos desiguales también en el encabezado: el título no ocupa toda la banda
     y la entradilla se apoya en su base, no en su tapa. */
  .encabezado--partido {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: clamp(var(--space-8), 6vw, var(--space-24));
    align-items: end;
  }
  .entradilla {
    font-size: var(--text-lead);
    line-height: 1.7;
    max-width: 66ch;
    color: var(--ink-soft);
  }
  @media (max-width: 60rem) {
    .encabezado--partido { grid-template-columns: 1fr; align-items: start; }
  }

  /* --- Bandas de color ----------------------------------------------------
     ⚠️ La tinta se pasa por HERENCIA (`color` en la sección), nunca con un
     `:global(p)`. Un selector así alcanza también a los párrafos de los bloques
     CLAROS que viven dentro de la banda —el aviso de contenido pendiente sobre
     púrpura, por ejemplo— y les pinta el texto casi blanco sobre fondo hueso.
     Con herencia, cualquier bloque que declare su propio fondo declara su tinta
     y queda a salvo. */
  .seccion--oscura { background: var(--void); color: var(--void-text); }
  .seccion--carbon { background: #0B0B0B; color: var(--void-text); }

  .seccion--oscura :global(h2),
  .seccion--carbon :global(h2) { color: var(--surface); }

  .seccion--oscura .entradilla,
  .seccion--carbon .entradilla { color: var(--void-mute); }

  /* Sobre negro el destacado va en VERDE (12,82:1), el mismo del hero. Nunca en
     `--brand`: da 3,53:1 y §11 lo señala como el error que este sistema invita a
     cometer, porque es el color que uno usaría por costumbre. */
  .seccion--oscura :global(.destacado),
  .seccion--carbon :global(.destacado) { color: var(--viv-verde); }

  /* --- Bandas de color a sangre ------------------------------------------
     Secciones enteras teñidas, no bloques sueltos: es lo que da la energía de
     la referencia. La tinta sale de la regla medida en tokens.css — turquesa
     lleva oscura (11.32:1), púrpura lleva blanca (5.85:1). No se invierten. */
  .seccion--turquesa {
    background: var(--viv-turquesa);
    color: var(--accent-ink);
  }
  .seccion--turquesa :global(h2) { color: var(--accent-ink); }
  .seccion--turquesa .eyebrow,
  .seccion--turquesa .entradilla { color: #0F3D39; }
  /* El teal de marca da 3,80:1 sobre el turquesa: pasa el umbral de titular por
     los pelos y se apaga. El teal profundo sube a 5,67:1 sin salir de la marca. */
  .seccion--turquesa :global(.destacado) { color: var(--brand-deep); }

  .seccion--purpura {
    background: var(--viv-purpura);
    color: #EDE4FF;
  }
  .seccion--purpura :global(h2) { color: #fff; }
  .seccion--purpura .eyebrow { color: #D6C2FF; }
  /* ⚠️ El teal de marca sobre púrpura da **1,02:1** — el peor par posible del
     sistema, prácticamente invisible. Es la trampa del título bicolor: `.destacado`
     hereda `--brand` de global.css y nadie lo revisa al teñir una banda. Amarillo
     (4,58:1) mantiene el patrón bicolor; el blanco lo perdería, porque el resto
     del titular ya es blanco. */
  .seccion--purpura :global(.destacado) { color: var(--viv-amarillo); }
</style>
