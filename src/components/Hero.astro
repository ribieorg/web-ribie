---
import NodeTexture from './NodeTexture.astro';
import Marca from './Marca.astro';
import { hero } from '../data/contenido';
---

<section class="hero">
  <div class="fondo" aria-hidden="true">
    <NodeTexture variante="oscura" opacidad={0.5} />
  </div>

  <div class="contenedor cuerpo">
    <p class="eyebrow eyebrow--claro">{hero.eyebrow}</p>
    <h1>
      {hero.titulo}<br />
      <span class="resalte">{hero.tituloDestacado}</span>
    </h1>
    <p class="entrada">{hero.entrada}</p>
    <div class="acciones">
      <a href={hero.cta.ancla} class="boton boton--accion">{hero.cta.texto}</a>
      <Marca activo={hero.provisional} texto="Texto provisional" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 78% 12%, oklch(58% 0.10 210) 0%, transparent 60%),
      linear-gradient(160deg, var(--brand) 0%, var(--brand-deep) 100%);
    color: #fff;
    padding-block: clamp(5rem, 12vw, 10rem);
  }

  .fondo { position: absolute; inset: 0; z-index: -1; }

  /* La zona central queda despejada: el texto manda sobre la textura */
  .fondo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 60% at 30% 50%, var(--brand-deep) 0%, transparent 70%);
    opacity: 0.85;
  }

  .cuerpo { position: relative; max-width: 52rem; }

  .eyebrow--claro { color: rgba(255, 255, 255, 0.72); }

  h1 { color: #fff; }

  /* Título bicolor sobre fondo oscuro: el verde del manual tiene contraste suficiente */
  .resalte { color: oklch(84% 0.13 140); }

  .entrada {
    font-size: var(--text-lead);
    color: rgba(255, 255, 255, 0.86);
    margin-top: var(--space-6);
    max-width: 44ch;
  }

  .acciones {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-8);
  }
</style>
