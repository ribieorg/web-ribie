---
/**
 * Hero — dirección `institucional con evidencia` (DESIGN.md §14, D51).
 *
 * Lo que este hero NO tiene, y es deliberado: corte en diagonal, plano de azul
 * eléctrico y tarjetas de color con flecha. Eso era la firma del Alan Turing
 * Institute —incluido su `#2B2BF5`—, trasladada tal cual, y es la razón por la
 * que el cliente decía que el sitio no lo representaba.
 *
 * Lo que tiene en su lugar: texto a la izquierda sobre blanco, fotografía real
 * de la red sangrando por el borde derecho, y una cinta con cuatro datos
 * verificables debajo. La evidencia manda sobre el efecto: cada pieza del hero
 * es un dato o un registro, no un gesto.
 */
import Duo from './Duo.astro';
import Chip from './Chip.astro';
import { hero, cifras } from '../data/contenido';
---

<section class="hero g">
  <div class="texto reveal">
    <span class="eyebrow">{hero.eyebrow}</span>
    <h1>
      {hero.titulo} <em>{hero.tituloDestacado}</em>
    </h1>
    {hero.entrada && <p class="entrada">{hero.entrada}</p>}
    <div class="acciones">
      <a class="boton boton--accion" href={hero.botonPrimario.ancla}>{hero.botonPrimario.texto}</a>
      <a class="boton boton--contorno" href={hero.botonSecundario.ancla}>{hero.botonSecundario.texto}</a>
    </div>
  </div>

  <div class="retrato">
    <Duo
      imagen={hero.imagen}
      alt={hero.pieImagen}
      proporcion="5/4"
      sizes="(max-width: 47.5rem) 100vw, 50vw"
      anchos={[720, 1200, 1800]}
      prioritaria
      clase="parallax"
    />
    {hero.pieImagen && (
      <p class="pie">
        {hero.pieImagen} <Chip activo={hero.anioPorConfirmar} texto="año por confirmar" />
      </p>
    )}
  </div>

  {cifras.length > 0 && (
    <dl class="cinta reveal">
      {cifras.map((c) => (
        <div class="dato">
          <dt class="valor">
            {c.valor}{c.unidad && <small>{c.unidad}</small>}
          </dt>
          <dd class="etiqueta">
            {c.etiqueta} <Chip activo={c.porConfirmar} />
          </dd>
        </div>
      ))}
    </dl>
  )}
</section>

<style>
  .hero {
    padding-top: clamp(3rem, 7vh, 5.5rem);
    align-items: end;
    row-gap: var(--space-12);
  }

  .texto { grid-column: 1 / 7; }
  .eyebrow {
    display: block;
    font-size: var(--text-eyebrow);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--brand);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-hero);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--ink);
    margin: var(--space-4) 0 0;
    text-wrap: balance;
  }
  /* La segunda línea del titular en turquesa: el color de la casa entra por el
     titular, no por un plano de fondo. */
  h1 em { font-style: normal; color: var(--brand); }

  .entrada {
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--ink-700);
    max-width: 50ch;
    margin: var(--space-6) 0 var(--space-8);
    text-wrap: pretty;
  }
  .acciones { display: flex; gap: var(--space-3); flex-wrap: wrap; }

  /* La fotografía sangra por el borde derecho: es lo que impide que el hero se
     lea como dos columnas de una plantilla. */
  .retrato {
    grid-column: 7 / 13;
    margin-right: calc(var(--margen) * -1);
  }
  .pie {
    font-size: .78125rem;
    color: var(--ink-500);
    text-align: right;
    margin: var(--space-3) var(--margen) 0 0;
  }

  /* Cinta de datos: cuatro cifras alineadas al margen, sin tarjetas ni iconos.
     Un filete arriba y aire. */
  .cinta {
    grid-column: 1 / 13;
    display: grid;
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    column-gap: clamp(2rem, 6vw, 6rem);
    row-gap: var(--space-6);
    border-top: 1px solid var(--border-strong);
    margin-top: var(--space-2);
    padding-top: var(--space-6);
    margin-bottom: 0;
  }
  .dato { min-width: 0; }
  .valor {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(2.5rem, 3.4vw, 3.5rem);
    line-height: 1;
    color: var(--brand-deep);
    font-variant-numeric: tabular-nums;
  }
  .valor small {
    font-family: var(--font-text);
    font-size: .38em;
    font-weight: 600;
    color: var(--ink-500);
    letter-spacing: .08em;
    text-transform: uppercase;
    margin-left: 6px;
  }
  .etiqueta {
    font-size: .875rem;
    color: var(--ink-700);
    margin: var(--space-2) 0 0;
  }

  @media (max-width: 47.5rem) {
    .texto, .retrato { grid-column: 1 / 13; }
    .retrato { margin-left: calc(var(--margen) * -1); }
    .pie { margin-right: var(--margen); }
    .cinta { grid-template-columns: 1fr 1fr; }
  }

  /* Parallax del duotono: solo `transform`, ligado al scroll con CSS nativo.
     Sin librería, sin listener, sin trabajo en el hilo principal (D53). */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .retrato :global(.parallax img) {
        animation: deriva linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
        transform: scale(1.06);
      }
    }
  }
  @keyframes deriva {
    from { transform: scale(1.06) translateY(-2.5%); }
    to   { transform: scale(1.06) translateY(2.5%); }
  }
</style>
