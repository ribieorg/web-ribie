---
/**
 * Nodos e instituciones de la red — muro de bloques planos.
 *
 * La jerarquía es **país arriba, sede debajo**, siguiendo la maqueta de
 * referencia. Es deliberado y no cosmético: RIBIE se organiza en nodos
 * *nacionales*, y cada nodo designa una institución como sede de coordinación.
 * Un muro de logotipos diría "estas universidades nos apoyan"; un muro de países
 * dice "la red cubre estos países, y en cada uno coordina esta institución", que
 * es lo que la red es.
 *
 * El logotipo no desaparece: cuando la hoja trae uno, va discreto al pie de la
 * celda. Así el muro conserva su lectura de mapa y sigue demostrando que las
 * imágenes se descargan solas desde las carpetas del Drive.
 *
 * `sync-contenido.mjs` baja los logos a `src/assets/remoto/` y aquí se resuelven
 * con `import.meta.glob` para que Astro los optimice a WebP con `width`/`height`.
 * El sitio no depende de Google en tiempo de ejecución ni hace *hotlinking* al
 * servidor de cada universidad.
 */
import { Image } from 'astro:assets';
import ListaPendiente from './ListaPendiente.astro';
import { organizaciones } from '../data/contenido';

// Astro necesita conocer las imágenes en tiempo de compilación: el glob las recoge todas.
const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/remoto/*.{png,jpg,jpeg,webp,gif}',
  { eager: true }
);
const porNombre = new Map(
  Object.entries(archivos).map(([ruta, mod]) => [ruta.split('/').pop()!, mod.default])
);

const items = organizaciones.items ?? [];
---

{items.length === 0 ? (
  <ListaPendiente
    texto="Aquí irán los nodos nacionales de la red y su sede de coordinación."
    formato="Por nodo: país, nombre oficial de la institución que coordina, sitio web y —si lo hay— logo en PNG con fondo transparente o SVG (mín. 600 px de ancho)."
  />
) : (
  <>
  {/* Un listado de instituciones se lee como una afirmación de pertenencia. Mientras
      RIBIE no lo confirme, la advertencia va JUNTO al listado, no en el encabezado. */}
  {organizaciones.provisional && organizaciones.nota && (
    <p class="nota-listado reveal">{organizaciones.nota}</p>
  )}
  <ul class="muro reveal">
    {items.map((n) => {
      const img = n.logo ? porNombre.get(n.logo) : undefined;
      const Contenido = (
        <>
          {/* El país manda: es el nodo. La institución es su sede. */}
          <span class="pais">{n.pais || n.nombre}</span>
          {n.pais && <span class="sede">{n.nombre}</span>}
          {img && (
            <Image src={img} alt="" height={56} format="webp" quality={88} class="logo" />
          )}
        </>
      );

      return (
        <li class="celda">
          {n.sitio ? (
            <a href={n.sitio} target="_blank" rel="noopener noreferrer">{Contenido}</a>
          ) : (
            <div>{Contenido}</div>
          )}
        </li>
      );
    })}
  </ul>
  </>
)}

<style>
  /* Bloque plano, sin radio: un aviso no necesita una caja para leerse como aviso */
  .nota-listado {
    margin-bottom: var(--space-8);
    padding: var(--space-4) var(--space-6);
    border-left: 4px solid var(--accent);
    background: oklch(72.8% 0.156 65.9 / 0.12);
    color: var(--ink);
    font-size: var(--text-small);
    max-width: 76ch;
  }

  /* Muro DENSO: dieciocho bloques apretados leen como una red; los mismos
     dieciocho con aire de sobra leen como una galería de logotipos. La densidad
     es parte de lo que dice esta sección. */
  .muro {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: var(--space-6) var(--space-4);
  }
  /* Bloques planos, sin anillo ni sombra (§11): la separación la hace el color
     de fondo y el espacio. El nodo se marca con una regla superior. */
  .celda a, .celda div {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-4) var(--space-6) var(--space-6);
    background: var(--surface-alt);
    border-top: 4px solid var(--viv-cian);
    text-decoration: none;
    text-align: left;
    height: 100%;
    transition: background var(--dur-micro) var(--ease-out);
  }
  .celda a:hover { background: var(--brand-tint); }
  .celda:nth-child(4n + 2) a, .celda:nth-child(4n + 2) div { border-top-color: var(--viv-magenta); }
  .celda:nth-child(4n + 3) a, .celda:nth-child(4n + 3) div { border-top-color: var(--viv-verde); }
  .celda:nth-child(4n + 4) a, .celda:nth-child(4n + 4) div { border-top-color: var(--viv-purpura); }

  .pais {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3125rem;
    letter-spacing: 0.01em;
    line-height: 1.1;
    color: var(--ink);
  }
  .sede {
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  /* El logotipo acompaña, no encabeza: en gris y pequeño para no competir con
     veinte paletas distintas ni con la marca de RIBIE. */
  .logo {
    margin-top: var(--space-3);
    height: 3.5rem;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
    transition: filter var(--dur-standard) var(--ease-out),
                opacity var(--dur-standard) var(--ease-out);
  }
  .celda a:hover .logo { filter: none; opacity: 1; }
</style>
