---
/**
 * Colaboradores — muro de bloques blancos sobre la banda púrpura.
 *
 * Bloques planos con el nombre alineado a su base: sin logotipos, porque los
 * organismos que acompañan a la red tienen marcas muy distintas entre sí y un
 * muro de logos ajenos sobre púrpura no lo aguanta ningún sistema. El nombre en
 * la tipografía de titulares basta y pesa lo justo.
 *
 * Si no hay nadie cargado, cae al marcador de pendiente en vez de inventar
 * nombres: aquí irían personas e instituciones reales.
 */
import ListaPendiente from './ListaPendiente.astro';
import { colaboradores } from '../data/contenido';

const items = colaboradores.items ?? [];
---

{items.length === 0 ? (
  <ListaPendiente
    texto="Aquí irán el comité científico, la organización y la dirección de la red."
    formato="Por persona: nombre, cargo, institución y retrato cuadrado de mín. 800 × 800 px."
    huecos={4}
  />
) : (
  <ul class="muro reveal">
    {items.map((c) => (
      <li class:list={['colaborador', c.pendiente && 'colaborador--pendiente']}>
        <span class="nombre">{c.nombre}</span>
        {c.cargo && <span class="cargo">{c.cargo}</span>}
        {c.institucion && <span class="institucion">{c.institucion}</span>}
      </li>
    ))}
  </ul>
)}

<style>
  .muro {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--space-6);
  }

  /* Alineado a la BASE: los nombres tienen longitudes muy distintas y anclarlos
     abajo les da una línea común. Alineados arriba, cada bloque terminaría en un
     sitio y el muro se leería descosido. */
  .colaborador {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-1);
    min-height: 7.5rem;
    padding: var(--space-6);
    background: var(--surface-alt);
    color: var(--ink);
  }

  .nombre {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.375rem;
    line-height: 1.12;
  }
  .cargo { font-size: var(--text-small); color: var(--ink-soft); }
  .institucion { font-size: var(--text-eyebrow); color: var(--ink-faint); }

  /* El hueco que falta se declara con el mismo lenguaje que el resto del sitio */
  .colaborador--pendiente .nombre {
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
  }
</style>
