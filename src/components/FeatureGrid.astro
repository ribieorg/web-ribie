---
/**
 * Objetivos — bloques de color plano, escalonados sobre doce columnas.
 *
 * Cada objetivo ES un bloque de color entero. La versión anterior le ponía una
 * reglita de color arriba y dejaba el resto sobre el fondo de la banda: eso es
 * una tarjeta disimulada, y un bloque de color plano vale más que una tarjeta
 * con borde (§11, "Do's" 2).
 *
 * El escalonado sale del dato (`inicio`/`ancho`/`desfase` en contenido.ts), no
 * de reglas `nth-child` cableadas aquí: el orden de los objetivos lo decide
 * RIBIE, y la maqueta tiene que sobrevivir a que lo cambien.
 */
import { objetivos } from '../data/contenido';
---

<ul class="rejilla">
  {objetivos.items.map((item, i) => (
    <li
      class:list={['objetivo', `objetivo--${item.variante}`, 'reveal']}
      style={`--inicio:${item.inicio};--ancho:${item.ancho};--desfase:${item.desfase}px;--i:${i}`}
    >
      <p class="numero">{String(i + 1).padStart(2, '0')}</p>
      <h3>{item.titulo}</h3>
      <p class="texto">{item.texto}</p>
    </li>
  ))}
</ul>

<style>
  /* `align-items: start` y no el `stretch` por defecto: sin él, cada bloque se
     estira hasta la altura del más alto de su fila y el primero acaba con un
     tercio de aire muerto debajo del texto. Los bloques miden lo que dicen. */
  .rejilla {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-6);
    align-items: start;
  }

  .objetivo {
    grid-column: var(--inicio) / span var(--ancho);
    margin-top: var(--desfase, 0);
    padding: var(--space-8) var(--space-8) var(--space-12) var(--space-8);
    /* escalonado máximo de 60 ms entre hermanos (DESIGN.md §5) */
    transition-delay: calc(var(--i) * 60ms);
  }

  .numero {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-eyebrow);
    letter-spacing: 0.14em;
  }
  h3 {
    margin-top: var(--space-4);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.06;
  }
  .texto {
    margin-top: var(--space-3);
    font-size: var(--text-small);
    line-height: 1.65;
    max-width: 40ch;
  }

  /* --- Regla de tinta: cada fondo trae medido su color de texto ------------
     Los pares salen de tokens.css y no se invierten. Ninguno de estos bloques
     usa --brand como tinta: sobre oscuro da 3,53:1 y es justo el error que este
     sistema invita a cometer (§11, "Don't" 2). */
  .objetivo--blanco {
    background: var(--surface-alt);
    color: var(--ink);
  }
  .objetivo--blanco .numero { color: var(--brand); }
  .objetivo--blanco .texto  { color: var(--ink-soft); }

  .objetivo--negro {
    background: var(--void);
    color: #fff;
  }
  .objetivo--negro .numero { color: var(--viv-turquesa); }
  .objetivo--negro .texto  { color: var(--void-text); }

  .objetivo--purpura {
    background: var(--viv-purpura);
    color: #fff;                      /* 5,85:1 */
  }
  .objetivo--purpura .numero { color: #EADDFF; }   /* 4,53:1 — el número es de 13px */
  .objetivo--purpura .texto  { color: #EADDFF; }

  .objetivo--amarillo {
    background: var(--viv-amarillo);
    color: var(--ink);                /* luminoso → tinta oscura, 13,90:1 */
  }
  .objetivo--amarillo .numero { color: var(--ink); }
  /* El amarillo empuja el texto pequeño a parecer más ligero de lo que es: medio
     punto de peso lo devuelve a su sitio sin tocar el color. */
  .objetivo--amarillo .texto  { color: var(--ink); font-weight: 500; }

  .objetivo--azul {
    background: var(--viv-azul);
    color: #fff;                      /* 7,59:1 */
  }
  .objetivo--azul .numero { color: #C9C9FF; }
  .objetivo--azul .texto  { color: #DEDEFF; }

  /* --- Adaptación --------------------------------------------------------
     Dos columnas, aún desfasadas: el punto no es que quepan, es que no se
     alineen. El 3×2 simétrico no debe reaparecer por la puerta de atrás. */
  @media (max-width: 60rem) {
    .rejilla { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .objetivo { grid-column: span 3; margin-top: 0; }
    .objetivo:nth-child(even) { margin-top: var(--space-8); }
  }
  @media (max-width: 40rem) {
    .rejilla { gap: var(--space-4); }
    .objetivo,
    .objetivo:nth-child(even) { grid-column: 1 / -1; margin-top: 0; }
  }
</style>
