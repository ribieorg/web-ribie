---
/**
 * Marca de "contenido provisional".
 * Solo se pinta si MOSTRAR_MARCAS está activo en src/data/contenido.ts.
 * Existe para que nadie confunda el material de relleno con contenido aprobado
 * por RIBIE — y para que apagarlas todas sea cambiar una sola línea.
 */
import { MOSTRAR_MARCAS } from '../data/contenido';

interface Props {
  activo?: boolean;
  texto?: string;
}
const { activo = true, texto = 'Contenido provisional' } = Astro.props;
const visible = MOSTRAR_MARCAS && activo;
---

{visible && <span class="provisional">{texto}</span>}
