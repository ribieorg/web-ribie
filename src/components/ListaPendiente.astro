---
/**
 * Marcador de sección cuyo contenido aún no ha entregado RIBIE
 * (nodos y organizaciones, colaboradores, redes).
 *
 * Deliberadamente NO usa fotos ni logos de relleno: el DESIGN prohíbe stock y
 * datos inventados. Muestra qué irá aquí y en qué formato, de modo que sirva
 * también como recordatorio visual de lo que falta.
 */
interface Props {
  texto: string;
  formato?: string;
  huecos?: number;
}
const { texto, formato, huecos = 6 } = Astro.props;
---

<div class="pendiente reveal">
  <div class="huecos" aria-hidden="true">
    {Array.from({ length: huecos }).map(() => <span class="hueco"></span>)}
  </div>
  <div class="aviso">
    <p class="texto">{texto}</p>
    {formato && <p class="formato">{formato}</p>}
  </div>
</div>

<style>
  /* Bloque plano, sin radio ni anillo (§11). Declara su propio fondo, así que
     declara también su tinta: sin ese `color` heredaría el de la banda —tinta
     clara sobre púrpura— y quedaría ilegible sobre este fondo hueso. */
  .pendiente {
    display: grid;
    gap: var(--space-8);
    padding: var(--space-8);
    background: var(--surface);
    color: var(--ink);
  }
  .huecos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-4);
  }
  .hueco {
    height: 4.5rem;
    background:
      repeating-linear-gradient(
        -45deg,
        var(--surface-alt) 0 8px,
        transparent 8px 16px
      );
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .texto { font-weight: 500; color: var(--ink); }
  .formato { color: var(--ink-soft); font-size: var(--text-small); margin-top: var(--space-1); }
</style>
