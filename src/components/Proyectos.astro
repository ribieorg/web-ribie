---
/**
 * Proyectos y gobernanza — bloque apaisado a doble columna + dos columnas.
 *
 * La pieza de anchos más desiguales del sitio: un bloque que ocupa media pantalla
 * y llega a 760px de alto, contra dos columnas estrechas de foto y texto. Es lo
 * que impide que el mosaico de Actualidad y este se lean como la misma cosa
 * repetida (§11.3, "anchos desiguales entre secciones").
 *
 * ⚠️ Mismo criterio que `Actualidad.astro`: sin material de RIBIE, los huecos se
 * declaran. Ni un titular de relleno.
 */
import Rayado from './Rayado.astro';
import Marca from './Marca.astro';
import { proyectos } from '../data/contenido';
---

<section id="proyectos" class="proyectos" aria-label="Proyectos y gobernanza de la red">
  <div class="mosaico reveal">
    <article class="destacado">
      <Rayado
        id="ribieProyectoDestacado"
        ancho={860}
        alto={760}
        paso={18}
        anchoRaya={8}
        fondo="#101010"
        raya="#1C1C1C"
      />
      <p class="destacado__pie">{proyectos.destacado.pie}</p>
      {proyectos.destacado.titulo ? (
        <h3 class="destacado__titulo">{proyectos.destacado.titulo}</h3>
      ) : (
        <>
          <p class="destacado__formato">{proyectos.destacado.formato}</p>
          <p class="destacado__marca"><Marca texto="Sin contenido cargado" /></p>
        </>
      )}
    </article>

    {proyectos.columnas.map((columna, i) => (
      <article class="columna">
        <div class="columna__media" style={`--filete:${columna.filete}`}>
          <Rayado
            id={`ribieProyectoColumna${i}`}
            ancho={420}
            alto={430}
            inclinacion={columna.inclinacion}
            fondo="#111111"
            raya="#1E1E1E"
            pie={columna.pie}
          />
          {/* Muesca triangular que muerde el borde inferior de la imagen: el único
              gesto ornamental del sitio, y viene de la referencia. */}
          <span class="muesca" aria-hidden="true"></span>
        </div>
        <div class:list={['columna__texto', i === 1 && 'columna__texto--acento']}>
          {proyectos.items[i] ? (
            <>
              <p class="titular">{proyectos.items[i].titulo}</p>
              <p class="entradilla">{proyectos.items[i].entradilla}</p>
              <p class="meta">
                {proyectos.items[i].origen}<br />
                {proyectos.items[i].seccion}<br />
                {proyectos.items[i].etiquetas}
              </p>
            </>
          ) : (
            <>
              <p class="rotulo">[ proyecto ]</p>
              <p class="campo campo--titular">Titular · hasta 80 caracteres</p>
              <p class="campo">Entradilla · una o dos líneas</p>
              <p class="campo campo--meta">
                vía &lt;quién lo publica&gt; · &lt;fecha&gt;<br />
                en &lt;área&gt;<br />
                #etiquetas
              </p>
            </>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .proyectos { background: var(--surface); border-top: 1px solid var(--border); }

  .mosaico {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
  }

  /* El bloque apaisado: dos columnas de ancho y casi el doble de alto que sus
     vecinas. La desproporción es el punto. */
  .destacado {
    grid-column: 1 / span 2;
    position: relative;
    min-height: 47.5rem;
    overflow: hidden;
    background: #0E0E0E;
  }
  .destacado__pie {
    position: absolute;
    left: var(--margen);
    top: var(--space-8);
    max-width: 34ch;
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    line-height: 1.6;
    color: #82827D;                  /* 4,55:1 sobre la raya clara */
  }
  /* El hueco del titular ocupa el sitio donde irá el titular real, abajo a la
     izquierda, para que se vea la jerarquía final aunque el texto no esté. */
  .destacado__formato {
    position: absolute;
    left: var(--margen);
    right: var(--space-8);
    bottom: calc(var(--space-8) + 2rem);
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 0.8125rem;
    color: #9A9A94;
  }
  .destacado__marca { position: absolute; left: var(--margen); bottom: var(--space-8); }
  /* El pie del hueco de Rayado estorbaría al del propio destacado */
  .destacado :global(.pie-hueco) { display: none; }

  .columna { display: flex; flex-direction: column; }
  .columna__media {
    position: relative;
    min-height: 26rem;
    overflow: hidden;
    background: #0E0E0E;
    border-bottom: 4px solid var(--filete);
  }
  .columna:last-child .columna__texto { padding-right: var(--margen); }

  .muesca {
    position: absolute;
    left: var(--space-8);
    bottom: -1px;
    width: 34px;
    height: 16px;
    background: var(--surface);
    clip-path: polygon(0 100%, 50% 0, 100% 100%);
  }

  .columna__texto {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-8) var(--space-6);
    background: var(--surface-alt);
    flex: 1;
  }

  .rotulo {
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--accent);
    font-weight: 600;
  }
  .campo {
    font-family: ui-monospace, "SFMono-Regular", Menlo, monospace;
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--ink-faint);
  }
  .campo--titular { font-size: 0.875rem; color: var(--ink-soft); }
  .campo--meta { margin-top: auto; font-size: 0.6875rem; }

  /* --- Proyecto real ------------------------------------------------------ */
  /* El titular sobre la imagen del bloque apaisado: en la fuente de titulares,
     porque aquí sí manda —es la pieza más grande de la sección— y no compite
     con nada dentro de su bloque. */
  .destacado__titulo {
    position: absolute;
    left: var(--margen);
    right: var(--space-8);
    bottom: var(--space-8);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.75rem, 1.2rem + 1.4vw, 2.5rem);
    line-height: 1.04;
    letter-spacing: var(--tracking-display);
    color: #fff;
    max-width: 24ch;
  }

  .titular {
    font-family: var(--font-text);
    font-weight: 700;
    font-size: 1.3125rem;
    line-height: 1.22;
    letter-spacing: -0.01em;
  }
  .entradilla { font-size: 1rem; line-height: 1.55; color: var(--ink-soft); }
  .meta {
    margin-top: auto;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-faint);
  }
  .columna__texto--acento .titular,
  .columna__texto--acento .entradilla { color: var(--viv-azul); }

  @media (max-width: 74rem) {
    .mosaico { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .destacado { grid-column: 1 / span 2; min-height: 32rem; }
  }
  @media (max-width: 47.5rem) {
    .mosaico { grid-template-columns: minmax(0, 1fr); }
    .destacado { grid-column: 1 / -1; min-height: 26rem; }
    .columna__media { min-height: 20rem; }
    .columna__texto,
    .columna:last-child .columna__texto { padding-inline: var(--margen); }
  }
</style>
