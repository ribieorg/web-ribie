---
/**
 * Layout base.
 *
 * ⚠️ Este archivo ya no lleva JavaScript. El reveal se hacía con un
 * `IntersectionObserver` y ahora lo resuelve `animation-timeline: view()` en
 * `global.css`: mismo efecto, cero bytes de script y sin trabajo en el hilo
 * principal (D53). El sitio vuelve a ser **HTML y CSS**, que es lo que se
 * prometió en §10.
 */

// Fuentes auto-hospedadas: nada de CDN de Google. Es un sitio institucional
// público y no hay razón para filtrar la IP de cada visitante a un tercero.
//
// Solo los subsets LATINOS: importar el paquete completo arrastra cirílico y
// vietnamita (23 archivos, ~600 KB en disco) que este sitio nunca va a servir.
import '@fontsource/oswald/latin-400.css';
import '@fontsource/oswald/latin-500.css';
import '@fontsource/oswald/latin-600.css';
import '@fontsource/onest/latin-400.css';
import '@fontsource/onest/latin-500.css';
import '@fontsource/onest/latin-600.css';
import '../styles/global.css';

import { sitio } from '../data/contenido';

interface Props {
  titulo?: string;
  descripcion?: string;
}
const {
  titulo = `${sitio.nombre} — ${sitio.nombreLargo}`,
  descripcion = 'Red académica que desde 1990 reúne a investigadores, docentes e instituciones de Iberoamérica en torno a la informática aplicada a la educación.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#096D84" />

    {/*
      Iconos de marca. Solo el ISOTIPO, nunca el logotipo completo: a 16 px el
      texto «Red RIBIE» se convierte en una mancha ilegible.

      Van sobre el turquesa `#096D84` —el mismo `theme-color` de arriba— porque
      el símbolo suelto es demasiado claro y se desvanece en las pestañas de
      tema claro. No es una licencia nuestra: el manual de marca (p. 3, «uso
      sobre fondos oscuros») autoriza el isotipo a color sobre fondo turquesa.

      El `.ico` lleva 48, 32 y 16 px remuestreados uno a uno, no un tamaño
      escalado: el navegador elige cuál usar, y a 16 px un buen remuestreo es
      la diferencia entre leerlo y no.
    */}
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="progreso" aria-hidden="true"></div>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <slot />

    <style>
      .saltar {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        padding: var(--space-3) var(--space-6);
        background: var(--surface);
        color: var(--brand);
        font-weight: 600;
        text-decoration: none;
        border: 1px solid var(--brand);
      }
      .saltar:focus { left: 0; }
    </style>
  </body>
</html>
