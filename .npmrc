# Defensas contra ataques de supply-chain — ver ~/.claude/vault/100-Buenas-Practicas/pnpm-obligatorio.md
# pnpm 10+ NO ejecuta scripts de instalación por defecto: solo los declarados en pnpm-workspace.yaml.

# No instalar versiones publicadas hace menos de 3 días (ventana de detección de paquetes comprometidos)
minimumReleaseAge=4320

# Sin hoisting: nada de phantom dependencies que ejecuten código no declarado
node-linker=isolated

# Bloqueo estricto de versiones
save-exact=false
resolution-mode=highest
